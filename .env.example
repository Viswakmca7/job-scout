# All optional. The app works fully with zero configuration using free,
# no-auth job APIs (RemoteOK, Arbeitnow, Remotive, Jobicy).

# How long aggregated results are cached before re-fetching from sources (seconds).
JOBSCOUT_CACHE_TTL=900

# Optional: adds local/non-remote job coverage via Adzuna (free account at
# https://developer.adzuna.com/). Leave unset to skip this source entirely.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
ADZUNA_QUERY=software

# Optional: Jooble aggregator API (free key at https://jooble.org/api/about).
# Jooble has its own legitimate partnerships across many boards (LinkedIn/Indeed do not
# offer a public search API to individual developers at all, so this is the closest
# legal substitute for that kind of broad coverage).
JOOBLE_API_KEY=
JOOBLE_SEED_QUERY=software OR developer OR engineer OR analyst OR designer
JOOBLE_LOCATION=

# Optional: track specific companies' official public career-page feeds.
# No key needed — these are public JSON APIs Greenhouse/Lever publish for embedding.
# Comma-separated board/company tokens (the slug in boards.greenhouse.io/<token> or
# jobs.lever.co/<token>).
JOBSCOUT_GREENHOUSE_BOARDS=
JOBSCOUT_LEVER_BOARDS=

# Optional: JSON map of company name (lowercase) -> affiliate apply URL.
# Jobs from these companies are tagged "Sponsored" and link out through your affiliate URL.
JOBSCOUT_AFFILIATES={}

# Where email signups from the "Get alerts" form are appended (JSON Lines).
JOBSCOUT_SUBSCRIBERS_FILE=subscribers.jsonl

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Job Scout: Run backend (F5)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8123"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Uvicorn running on (http://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
